    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "imapflow": "^2.2.5",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.15",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.2",
